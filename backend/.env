# ── Intelligent ERP Backend Environment Configuration (Development) ──

# Application Port
PORT=3000

# Mock ZATCA API Mode (Use true for local dev testing)
USE_MOCK_API=true
MOCK_API_KEY=zatca_test_key_123

# WhatsApp Integration (Local Dev Mocks)
WHATSAPP_APP_SECRET=mock_whatsapp_app_secret_456
WHATSAPP_VERIFY_TOKEN=zatca_webhook_token_789

# Local Development Database Connections
# Primary SQLite Local Database File Path
SQLITE_DB_PATH=sqlite.db

# Local PostgreSQL Database (Used for local cloud/multi-tenant schema dev)
DATABASE_URL="postgresql://admin:password123@localhost:5432/uae_invoice?sslmode=disable"

# Application Base URLs
NEXT_PUBLIC_API_BASE="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"