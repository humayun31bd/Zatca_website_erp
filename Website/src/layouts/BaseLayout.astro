---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang: string;
  dir: string;
  canonicalUrl: string;
}

const { title, description = "Intelligent ERP - Empowering Smart Business Growth", lang, dir, canonicalUrl } = Astro.props;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- SEO & i18n -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ar" href="https://intelligentdive.com/ar/" />
    <link rel="alternate" hreflang="en" href="https://intelligentdive.com/en/" />
    <link rel="alternate" hreflang="x-default" href="https://intelligentdive.com/ar/" />
    
    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": lang === 'ar' ? "إي آر بي الذكي" : "Intelligent ERP",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web, Android, iOS"
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>
